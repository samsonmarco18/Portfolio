# Configure these in Render's Environment settings. No .env loader is required.
ADMIN_PASSWORD=replace-with-your-own-password-12-to-72-characters
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
PORT=3000
# Render supplies RENDER_EXTERNAL_URL automatically.
# Set PUBLIC_URL=https://your-domain.example if using a custom domain.
